
-- =============================================================================
-- 北京禁飞区：一张表、一条数据；依赖PostGIS。
-- 中心点：东经116°23′27″、北纬39°54′10″；半径300000米。
-- 插入时沿WGS84椭球生成720段近似圆形面，geom保存二维水平范围。
-- =============================================================================
CREATE TABLE IF NOT EXISTS public.bo_no_fly_zone (
    id varchar(64) PRIMARY KEY,
    zone_name varchar(255) NOT NULL,
    center_geom geometry(Point, 4326) NOT NULL,
    radius_m double precision NOT NULL,
    geom geometry(Polygon, 4326) NOT NULL,
    remark varchar(1000)
);

COMMENT ON TABLE public.bo_no_fly_zone IS '禁飞区范围';
COMMENT ON COLUMN public.bo_no_fly_zone.id IS '禁飞区主键';
COMMENT ON COLUMN public.bo_no_fly_zone.zone_name IS '禁飞区名称';
COMMENT ON COLUMN public.bo_no_fly_zone.center_geom IS 'WGS84中心点，X经度、Y纬度';
COMMENT ON COLUMN public.bo_no_fly_zone.radius_m IS '半径，单位：米';
COMMENT ON COLUMN public.bo_no_fly_zone.geom IS '根据中心点和半径生成的WGS84二维区域面';
COMMENT ON COLUMN public.bo_no_fly_zone.remark IS '垂直范围、管制时间及覆盖范围说明';

WITH params AS (
    SELECT ST_SetSRID(ST_MakePoint(
               116.0 + 23.0 / 60.0 + 27.0 / 3600.0,
               39.0 + 54.0 / 60.0 + 10.0 / 3600.0
           ), 4326) AS center_geom,
           300000::double precision AS radius_m
), boundary AS (
    SELECT ST_MakeLine(
               ST_Project(p.center_geom::geography, p.radius_m, radians(s.step * 0.5))::geometry
               ORDER BY s.step
           ) AS ring
    FROM params p CROSS JOIN generate_series(0, 719) AS s(step)
)
INSERT INTO public.bo_no_fly_zone (id, zone_name, center_geom, radius_m, geom, remark)
SELECT
    'BEIJING-300KM',
    '北京禁飞区（半径300公里）',
    p.center_geom,
    p.radius_m,
    ST_MakePolygon(ST_AddPoint(b.ring, ST_StartPoint(b.ring))),
    '垂直范围：地（水）面至无限高；全天24小时管制。覆盖范围说明：北京全域、天津全域、河北大部分地区，并延伸至山西东部、内蒙古中南部、山东北部、辽宁部分区域以及渤海海域，总面积超过28万平方公里。'
FROM params p CROSS JOIN boundary b
WHERE true
ON CONFLICT (id) DO UPDATE
SET zone_name = EXCLUDED.zone_name,
    center_geom = EXCLUDED.center_geom,
    radius_m = EXCLUDED.radius_m,
    geom = EXCLUDED.geom,
    remark = EXCLUDED.remark;
