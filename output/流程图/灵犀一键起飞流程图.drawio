        <mxCell id="skip" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;div style=&quot;font-size:24px;color:#475569;font-weight:700;line-height:1.4;margin-top:0px;&quot;&gt;跳过该航线对&lt;/div&gt;&lt;div style=&quot;font-size:21px;color:#64748B;font-weight:400;line-height:1.4;margin-top:7px;&quot;&gt;继续检查其他组合&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=18;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=1.7;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
