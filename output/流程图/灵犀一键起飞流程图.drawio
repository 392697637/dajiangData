        <mxCell id="empty" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;div style=&quot;font-size:23px;color:#28745D;font-weight:700;line-height:1.4;margin-top:0px;&quot;&gt;计划集合为空&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#4E7F70;font-weight:400;line-height:1.4;margin-top:7px;&quot;&gt;直接返回两个空数组&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=18;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#EAF7F2;strokeColor=#B5DCCE;strokeWidth=1.7;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
