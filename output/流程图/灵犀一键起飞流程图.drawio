        <mxCell id="segments" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;div style=&quot;font-size:28px;color:#1E293B;font-weight:700;line-height:1.4;margin-top:0px;&quot;&gt;仅拆分命中的航线，逐航段复查&lt;/div&gt;&lt;div style=&quot;font-size:23px;color:#64748B;font-weight:400;line-height:1.4;margin-top:7px;&quot;&gt;ST_DumpSegments → 航段对三维距离 ≤ R&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=18;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#BFCBDC;strokeWidth=1.7;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
