        <mxCell id="project" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;div style=&quot;font-size:28px;color:#1E293B;font-weight:700;line-height:1.4;margin-top:0px;&quot;&gt;统一转换到局部米制坐标系&lt;/div&gt;&lt;div style=&quot;font-size:21px;color:#64748B;font-weight:400;line-height:1.4;margin-top:7px;&quot;&gt;以第一条计划机库为中心建立 AEQD 投影；Z 保持海拔米&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=18;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#BFCBDC;strokeWidth=1.7;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="390" y="910" width="700" height="100" as="geometry" />
        </mxCell>
        <mxCell id="plan_pairs" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;div style=&quot;font-size:28px;color:#254C82;font-weight:700;line-height:1.4;margin-top:0px;&quot;&gt;计划 × 计划&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#526B91;font-weight:400;line-height:1.4;margin-top:7px;&quot;&gt;仅比较 i &amp;lt; j，排除自身和反向重复对&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=18;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#B8CCEF;strokeWidth=1.7;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
