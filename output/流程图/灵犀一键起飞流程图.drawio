          <mxGeometry x="1150" y="295" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="plan" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;div style=&quot;font-size:28px;color:#254C82;font-weight:700;line-height:1.4;margin-top:0px;&quot;&gt;计划航线&lt;/div&gt;&lt;div style=&quot;font-size:23px;color:#334155;font-weight:400;line-height:1.4;margin-top:7px;&quot;&gt;读取机库位置与起降参数&lt;/div&gt;&lt;div style=&quot;font-size:23px;color:#334155;font-weight:400;line-height:1.4;margin-top:7px;&quot;&gt;调用公共函数生成完整航线&lt;/div&gt;&lt;div style=&quot;font-size:21px;color:#526B91;font-weight:400;line-height:1.4;margin-top:7px;&quot;&gt;起飞 → 规划 → 返航 → 降落&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=18;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#EEF4FF;strokeColor=#B8CCEF;strokeWidth=1.7;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="475" width="420" height="190" as="geometry" />
        </mxCell>
        <mxCell id="live_full" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;div style=&quot;font-size:27px;color:#62519B;font-weight:700;line-height:1.4;margin-top:0px;&quot;&gt;在飞航线 · 带机库位置&lt;/div&gt;&lt;div style=&quot;font-size:23px;color:#334155;font-weight:400;line-height:1.4;margin-top:7px;&quot;&gt;读取机库位置与起降参数&lt;/div&gt;&lt;div style=&quot;font-size:23px;color:#334155;font-weight:400;line-height:1.4;margin-top:7px;&quot;&gt;调用公共函数生成完整航线&lt;/div&gt;&lt;div style=&quot;font-size:21px;color:#756594;font-weight:400;line-height:1.4;margin-top:7px;&quot;&gt;与计划航线采用相同处理方式&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=18;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#F1EFFF;strokeColor=#C9BFF1;strokeWidth=1.7;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="530" y="475" width="420" height="190" as="geometry" />
        </mxCell>
        <mxCell id="live_ready" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;div style=&quot;font-size:25px;color:#28745D;font-weight:700;line-height:1.4;margin-top:0px;&quot;&gt;在飞航线 · 不带机库位置&lt;/div&gt;&lt;div style=&quot;font-size:23px;color:#334155;font-weight:400;line-height:1.4;margin-top:7px;&quot;&gt;route 已是海拔航线&lt;/div&gt;&lt;div style=&quot;font-size:23px;color:#334155;font-weight:400;line-height:1.4;margin-top:7px;&quot;&gt;校验三维坐标后直接使用&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#4E7F70;font-weight:400;line-height:1.4;margin-top:7px;&quot;&gt;支持剩余航线；断开的段不补线&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=18;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#EAF7F2;strokeColor=#B5DCCE;strokeWidth=1.7;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="990" y="475" width="420" height="190" as="geometry" />
