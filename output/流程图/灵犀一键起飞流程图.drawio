        <mxCell id="input" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;div style=&quot;font-size:27px;color:#254C82;font-weight:700;line-height:1.4;margin-top:0px;&quot;&gt;输入：计划航线集合 + 在飞航线集合 + 安全间距 R&lt;/div&gt;&lt;div style=&quot;font-size:22px;color:#526B91;font-weight:400;line-height:1.4;margin-top:7px;&quot;&gt;JSON 数组；R 的单位为米，默认 0&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=18;absoluteArcSize=1;html=1;whiteSpace=wrap;fillColor=#EDF4FF;strokeColor=#B8CCEF;strokeWidth=1.7;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
